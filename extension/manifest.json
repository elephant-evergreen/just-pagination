{
  "manifest_version": 3,
  "name": "Just Pagination",
  "version": "0.0.2",
  "description": "Move between pages of a list with the left and right arrow keys.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://images.pexels.com"},
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "exclude_matches": ["https://api.typesafe.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon.png"}
}
